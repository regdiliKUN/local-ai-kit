$('enhGen').onclick = runEnhance;

$('enhApply').onclick = () => {
  const cur = (enh.variants[enh.active] || '').trim();
  if (!cur) return;
  $('input').value = cur;
  autoGrow();
  setEnhBadge(true);
  $('enhInfo').textContent = '已应用到输入框，可以直接改，也可以直接发送';
  $('input').focus();
};

$('enhUndo').onclick = doUndoEnhance;
$('enhUndoLink').onclick = e => { e.preventDefault(); doUndoEnhance(); };

/* =========================================================
   七、提示词模板库
   ---------------------------------------------------------
   模板文本以换行结尾，点击时插到草稿「前面」，
   所以「请审查以下代码：\n\n」+ 你粘的代码 就是一条完整指令。
   ========================================================= */
const TEMPLATES = [
  { cat: '代码', items: [
    { t: '代码审查', p: '请审查以下代码，找出潜在的 bug、边界条件问题和改进点，按严重程度排序，并给出修改后的代码。\n\n' },
    { t: '重构建议', p: '请分析以下代码的结构问题，给出重构方案，说明每一步的理由，并输出重构后的代码。\n\n' },
    { t: '写单元测试', p: '请为以下代码编写单元测试，覆盖正常路径、边界条件和异常路径，并说明每个用例验证了什么。\n\n' },
    { t: '解释代码', p: '请逐段解释以下代码的作用、关键设计取舍和潜在陷阱，假设读者是刚接手这个项目的人。\n\n' },
    { t: '性能优化', p: '请找出以下代码的性能瓶颈，给出优化方案，并说明每项优化的预期收益和代价。\n\n' },
    { t: '补充注释', p: '请为以下代码补充清晰的中文注释和文档字符串，不要改动任何逻辑。\n\n' },
  ]},
  { cat: '文档', items: [
    { t: '写 README', p: '请为这个项目写一份 README，包含：项目简介、功能特性、安装步骤、快速开始、配置说明、常见问题。\n\n' },
    { t: '写提交信息', p: '请根据以下改动生成符合 Conventional Commits 规范的提交信息，并补充正文说明改动原因。\n\n' },
    { t: '翻译成中文', p: '请把以下内容翻译成中文，保持专业术语准确、语气自然，不要逐字硬译。\n\n' },
    { t: '提炼要点', p: '请把以下内容提炼成要点清单，保留关键数据和结论，去掉冗余表述。\n\n' },
  ]},
  { cat: '分析', items: [
    { t: '对比方案', p: '请对比以下方案，从实现复杂度、性能、可维护性、适用场景四个维度列表分析，最后给出明确推荐。\n\n' },
    { t: '找问题', p: '请找出以下内容中的逻辑漏洞、事实错误和自相矛盾之处，逐条指出并说明理由。\n\n' },
    { t: '帮我做决策', p: '请帮我就以下问题做决策：先列出可选方案，再列出评估标准，逐项打分，最后给出结论和主要风险。\n\n' },
    { t: '拆解任务', p: '请把以下目标拆解成可执行的步骤清单，标注每步的产出物、依赖关系和预估工作量。\n\n' },
  ]},
  { cat: '写作', items: [
    { t: '改成正式语气', p: '请把以下内容改写成正式、专业的书面语气，保留全部信息，不要添加新内容。\n\n' },
    { t: '扩写', p: '请把以下内容扩写成完整段落，补充必要的细节和例子，保持原意不变。\n\n' },
    { t: '精简一半', p: '请把以下内容精简到原来一半的长度，保留核心信息和关键数据。\n\n' },
  ]},
];

/* 属性值转义：必须先把 & 换掉，换行用 &#10; 保住 */
function attrEsc(s){
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/\n/g, '&#10;');
}

function renderTemplates(){
  let h = '';
  for (const cat of TEMPLATES){
    h += '<div class="tplcat"><h4>' + esc(cat.cat) + '</h4><div class="tplgrid">';
    for (const it of cat.items){
      h += '<div class="tplcard" data-p="' + attrEsc(it.p) + '">'
         +   '<div class="n">' + esc(it.t) + '</div>'
         +   '<div class="d">' + esc(it.p.replace(/\n/g, ' ').trim()) + '</div>'
         + '</div>';
    }
    h += '</div></div>';
  }
  $('tplGrid').innerHTML = h;
}

$('tplGrid').addEventListener('click', e => {
  const c = e.target.closest('.tplcard');
  if (!c) return;
  applyTemplate(c.dataset.p);
});

function applyTemplate(p){
  const inp = $('input');
  const s = inp.selectionStart, en = inp.selectionEnd;
  if (s != null && en != null && en > s){
    // 有选中内容：用模板替换选中部分
    inp.value = inp.value.slice(0, s) + p + inp.value.slice(en);
  }else{
    // 否则插到最前面
    inp.value = p + inp.value;
  }
  autoGrow();
  closePanels();
  inp.focus();
  inp.setSelectionRange(inp.value.length, inp.value.length);
}

/* 初始聚焦 */
input.focus();
