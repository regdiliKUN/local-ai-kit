/* =========================================================
   六、提示词增强
   ---------------------------------------------------------
   用本地模型改写草稿。调用是完全无状态的：
   它既不读也不写 state.history，所以不会污染主对话。
   ========================================================= */
const enh = {
  style: 'conservative',
  count: 2,
  variants: [],
  active: 0,
  backup: null,     // 增强前的原始草稿，用于「撤销」
  busy: false,
  ctrl: null,
};

function openPanel(id){
  ['enhPanel', 'tplPanel'].forEach(p => $(p).classList.toggle('show', p === id));
}
function closePanels(){
  $('enhPanel').classList.remove('show');
  $('tplPanel').classList.remove('show');
}

function setEnhBadge(on){
  $('enhBadge').style.display = on ? '' : 'none';
}

/* ---- 字符级 diff（LCS） ---- */
function diffOps(a, b){
  const A = Array.from(a), B = Array.from(b);
  const n = A.length, m = B.length;
  if (!n) return [{ op: '+', s: b }];
  if (!m) return [{ op: '-', s: a }];
  // 太长就不做精细 diff，避免卡界面
  if (n * m > 1200000) return [{ op: '-', s: a }, { op: '+', s: b }];

  const w = m + 1;
  const dp = new Uint32Array((n + 1) * w);
  for (let i = n - 1; i >= 0; i--){
    for (let j = m - 1; j >= 0; j--){
      dp[i * w + j] = A[i] === B[j]
        ? dp[(i + 1) * w + (j + 1)] + 1
        : Math.max(dp[(i + 1) * w + j], dp[i * w + (j + 1)]);
    }
  }
  const ops = [];
  const push = (op, ch) => {
    const last = ops[ops.length - 1];
    if (last && last.op === op) last.s += ch;
    else ops.push({ op, s: ch });
  };
  let i = 0, j = 0;
  while (i < n && j < m){
    if (A[i] === B[j]){ push('=', A[i]); i++; j++; }
    else if (dp[(i + 1) * w + j] >= dp[i * w + (j + 1)]){ push('-', A[i]); i++; }
    else { push('+', B[j]); j++; }
  }
  while (i < n) push('-', A[i++]);
  while (j < m) push('+', B[j++]);
  return ops;
}

function renderDiff(a, b){
  let left = '', right = '';
  for (const o of diffOps(a, b)){
    if (o.op === '='){ left += esc(o.s); right += esc(o.s); }
    else if (o.op === '-'){ left += '<span class="del">' + esc(o.s) + '</span>'; }
    else { right += '<span class="add">' + esc(o.s) + '</span>'; }
  }
  return { left, right };
}

function renderEnh(){
  const body = $('enhBody');
  const vs = enh.variants;
  if (!vs.some(v => v && v.trim())){
    body.innerHTML = '<div class="enh-empty">'
      + '点「生成」，用本地模型改写你的草稿。全程在本机完成，不出网。<br>'
      + '<span style="color:var(--text-faint)">'
      + '保守 = 只把话说清楚，不添加你没提过的需求；'
      + '激进 = 自动补全角色、背景、约束、输出格式。</span></div>';
    return;
  }
  let tabs = '';
  for (let i = 0; i < vs.length; i++){
    const n = (vs[i] || '').trim().length;
    tabs += '<button class="' + (i === enh.active ? 'on' : '') + '" data-v="' + i + '">'
          + '版本 ' + (i + 1) + (n ? ' · ' + n + ' 字' : '') + '</button>';
  }
  const cur = vs[enh.active] || '';
  const d = renderDiff(enh.backup || '', cur);
  body.innerHTML = '<div class="vtabs">' + tabs + '</div>'
    + '<div class="diff">'
    +   '<div class="col"><h4>原文 · ' + (enh.backup || '').length + ' 字</h4>' + d.left + '</div>'
    +   '<div class="col"><h4>增强后 · ' + cur.length + ' 字</h4>' + d.right + '</div>'
    + '</div>';
}

function updateEnhBtns(){
  const cur = (enh.variants[enh.active] || '').trim();
  $('enhApply').disabled = enh.busy || !cur;
  $('enhUndo').disabled = enh.backup == null;
}

async function runEnhance(){
  const draft = $('input').value.trim();
  if (!draft){
    $('enhInfo').textContent = '请先在输入框写点内容';
    return;
  }
  if (enh.busy) return;

  enh.backup = draft;
  enh.busy = true;
  enh.variants = [];
  enh.active = 0;
  enh.ctrl = new AbortController();
  $('enhGen').disabled = true;
  $('enhGen').textContent = '生成中…';
  $('enhApply').disabled = true;
  $('enhUndo').disabled = true;
  $('enhInfo').textContent = '正在改写…';
  renderEnh();

  const t0 = performance.now();
  let firstAt = 0, pending = false;
  const schedule = () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => { pending = false; renderEnh(); });
  };

  try{
    const res = await fetch('/api/enhance', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ draft, style: enh.style, count: enh.count }),
      signal: enh.ctrl.signal,
    });

    if (!res.ok){
      const j = await res.json().catch(() => ({}));
      $('enhInfo').textContent = '失败：' + (j.error || ('HTTP ' + res.status));
      return;
    }

    const reader = res.body.getReader();
    const dec = new TextDecoder('utf-8');
    let buf = '';

    while (true){
      const { done, value } = await reader.read();
      if (done) break;
      buf += dec.decode(value, { stream: true });
      let nl;
      while ((nl = buf.indexOf('\n')) >= 0){
        const line = buf.slice(0, nl).replace(/\r$/, '');
        buf = buf.slice(nl + 1);
        if (!line.startsWith('data:')) continue;
        const p = line.slice(5).trim();
        if (!p) continue;
        let ev;
        try{ ev = JSON.parse(p); }catch(e){ continue; }

        if (ev.type === 'delta'){
          if (!firstAt) firstAt = performance.now();
          enh.variants[ev.i] = (enh.variants[ev.i] || '') + ev.text;
          schedule();
        }else if (ev.type === 'variant'){
          if (enh.variants[ev.i] == null) enh.variants[ev.i] = '';
          schedule();
        }else if (ev.type === 'error'){
          $('enhInfo').textContent = '失败：' + ev.message;
        }
      }
    }

    // 规整稀疏数组，并丢掉空版本
    const norm = [];
    for (let i = 0; i < enh.variants.length; i++) norm.push(enh.variants[i] || '');
    const kept = norm.filter(v => v.trim());
    enh.variants = kept.length ? kept : [''];
    enh.active = Math.min(enh.active, enh.variants.length - 1);
    if (!(enh.variants[enh.active] || '').trim()) enh.active = 0;

    const dt = ((performance.now() - t0) / 1000).toFixed(2);
    const n = enh.variants.filter(v => v && v.trim()).length;
    $('enhInfo').textContent = n + ' 个版本 · 首字 '
      + (firstAt ? ((firstAt - t0) / 1000).toFixed(2) : '?') + 's · 共 ' + dt + 's';

  }catch(e){
    $('enhInfo').textContent = (e.name === 'AbortError')
      ? '已取消' : ('连接出错：' + e.message);
  }finally{
    enh.busy = false;
    enh.ctrl = null;
    $('enhGen').disabled = false;
    $('enhGen').textContent = '重新生成';
    renderEnh();
    updateEnhBtns();
  }
}

function doUndoEnhance(){
  if (enh.backup == null) return;
  $('input').value = enh.backup;
  autoGrow();
  setEnhBadge(false);
  $('enhInfo').textContent = '已撤销，恢复到增强前的草稿';
  $('input').focus();
}

/* ---- 打开 / 关闭 ---- */
$('btnEnhance').onclick = () => {
