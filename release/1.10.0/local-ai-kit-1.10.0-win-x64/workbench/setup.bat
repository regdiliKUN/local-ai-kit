@echo off
setlocal enabledelayedexpansion
title strata-dsh-workbench  -  setup

set "ROOT=%~dp0"
for %%I in ("%ROOT%.") do set "ROOT=%%~fI"

echo ==================================================
echo   strata-dsh-workbench   SETUP
echo ==================================================
echo.
echo   This will:
echo     1. detect where Strata, DeepSeek Harness, Node and Python live
echo     2. write config\paths.bat
echo     3. optionally create desktop shortcuts
echo.
echo   Nothing is installed or downloaded by this script.
echo.
pause

if not exist "%ROOT%\config\resolve.bat" (
    echo [ERROR] config\resolve.bat not found. Is the repo complete?
    pause
    exit /b 1
)

echo.
echo [1/3] Detecting paths ...
echo.
call "%ROOT%\config\resolve.bat"

echo       STRATA_HOME    = %STRATA_HOME%
echo       STRATA_DATA    = %STRATA_DATA%
echo       STRATA_PROFILE = %STRATA_PROFILE%
echo       DSH_DIR        = %DSH_DIR%
echo       NODE_EXE       = %NODE_EXE%
echo       PYTHON_EXE     = %PYTHON_EXE%
echo.

set "PROBLEM="
if not exist "%STRATA_SERVER%" set "PROBLEM=1"
if not exist "%DSH_BIN%"       set "PROBLEM=1"

if defined PROBLEM (
    echo   [WARN] Some components could not be located automatically.
    echo.
    echo          STRATA_HOME must contain serve\server.py
    echo          DSH_DIR     must contain node_modules\@deepseek-ai\dsh\lib\bin.js
    echo.
    echo          You will be able to correct them in config\paths.bat
    echo          after this script writes it.
    echo.
)

echo [2/3] Writing config\paths.bat ...
if exist "%ROOT%\config\paths.bat" (
    echo       A config\paths.bat already exists.
    choice /c YN /n /m "      Overwrite it with the detected values? [Y/N] "
    if errorlevel 2 goto keep
)

(
    echo @echo off
    echo REM ============================================================
    echo REM  AUTO-GENERATED by setup.bat on %DATE% %TIME%
    echo REM  Edit the values below if anything is wrong, then re-run
    echo REM  tools\verify.bat
    echo REM ============================================================
    echo.
    echo set "STRATA_HOME=%STRATA_HOME%"
    echo set "STRATA_DATA=%STRATA_DATA%"
    echo set "STRATA_PROFILE=%STRATA_PROFILE%"
    echo set "DSH_DIR=%DSH_DIR%"
    echo set "NODE_EXE=%NODE_EXE%"
    echo set "PYTHON_EXE=%PYTHON_EXE%"
    echo set "STRATA_PORT=%STRATA_PORT%"
    echo set "WEB_PORT=%WEB_PORT%"
    echo set "STRATA_API_KEY=%STRATA_API_KEY%"
) > "%ROOT%\config\paths.bat"

echo       wrote %ROOT%\config\paths.bat
goto shortcuts

:keep
echo       keeping the existing config\paths.bat

:shortcuts
echo.
echo [3/3] Desktop shortcuts
choice /c YN /n /m "      Create desktop shortcuts? [Y/N] "
if errorlevel 2 goto done

powershell -NoProfile -ExecutionPolicy Bypass -File "%ROOT%\tools\create-shortcuts.ps1" -Root "%ROOT%"

:done
echo.
echo ==================================================
echo   Setup finished.
echo ==================================================
echo.
echo   Recommended next steps
echo   --------------------------------------------------
echo   1. tools\verify.bat              check everything
echo   2. tools\install-strata.bat      only if Strata is not installed yet
echo   3. docs\03-integrate-dsh.md      wire the engine into dsh
echo   4. launchers\Strata-dsh-Workbench.bat   daily driver
echo.
pause
exit /b 0
