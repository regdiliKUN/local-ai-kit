{"id":"math-04","cat":"算术","prompt":"2 的 10 次方是多少？只输出数字。","check":{"type":"exact","value":"1024"}}
{"id":"reason-01","cat":"推理","prompt":"3 个人 3 天做 3 个零件。9 个人 9 天能做几个零件？只输出数字。","check":{"type":"exact","value":"27"}}
